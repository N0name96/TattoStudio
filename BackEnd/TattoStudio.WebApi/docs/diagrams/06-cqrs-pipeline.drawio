          <mxGeometry x="140" y="230" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="c3" value="mediator.Send(new XxxCommand(...))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="320" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="c4" value="IPipelineBehavior&lt;br&gt;ValidationBehavior&lt;T,R&gt;&lt;br&gt;ejecuta AbstractValidator&lt;T&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="410" width="220" height="80" as="geometry"/>
