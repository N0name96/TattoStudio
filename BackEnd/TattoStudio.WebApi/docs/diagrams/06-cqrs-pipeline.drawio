        <mxCell id="c5" value="¿Errores de validación?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="130" y="520" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="c6" value="throw ValidationException&lt;br&gt;→ 400 Bad Request&lt;br&gt;{ errors: [...] }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="530" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="c7" value="XxxCommandHandler.Handle()&lt;br&gt;— usa IRepository&lt;br&gt;— llama métodos de dominio&lt;br&gt;— _mapper.Map&lt;Result&gt;(entity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="630" width="260" height="100" as="geometry"/>
        </mxCell>

