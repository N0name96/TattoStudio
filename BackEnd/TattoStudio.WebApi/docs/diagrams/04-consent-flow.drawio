<mxfile>
  <diagram name="Consent Flow">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="2" value="Flujo de Consentimiento (Fase 4) — QR + Firma" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>

        <!-- ===== ACTORS ===== -->
        <mxCell id="act1" value="Staff (autenticado)" style="shape=mxgraph.flowchart.start_2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="act1l" value="Staff" style="text;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="155" width="60" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="act2" value="Cliente (anónimo)" style="shape=mxgraph.flowchart.start_2;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1440" y="90" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="act2l" value="Cliente" style="text;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1440" y="155" width="60" height="25" as="geometry"/>
        </mxCell>

        <!-- ===== PASO 1: Generar QR ===== -->
        <mxCell id="s1" value="PASO 1 — Generar QR" style="text;html=1;fontStyle=1;fontSize=13;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="s1a" value="GET /api/appointments/{id}/qr&lt;br&gt;Authorization: Bearer {JWT}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s1b" value="GenerateQrQueryHandler&lt;br&gt;→ ConsentTokenService.GenerateConsentToken(appointmentId)&lt;br&gt;→ JWT HS256, claim: appointmentId, exp: 30min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="400" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s1c" value="QRCoder genera PNG&lt;br&gt;codificado en Base64&lt;br&gt;URL incrustada: /api/public/consents/{token}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="400" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s1d" value="Respuesta:&lt;br&gt;{ qrBase64: &quot;iVBOR...&quot;, token: &quot;eyJ...&quot; }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="400" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s1e" value="Staff muestra el QR&lt;br&gt;en pantalla / imprime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="400" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="es1a" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s1a" target="s1b" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es1b" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s1b" target="s1c" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es1c" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s1c" target="s1d" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es1d" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s1d" target="s1e" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== PASO 2: Cliente escanea ===== -->
        <mxCell id="s2" value="PASO 2 — Cliente escanea el QR" style="text;html=1;fontStyle=1;fontSize=13;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="700" y="210" width="380" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="s2a" value="Cliente escanea QR con cámara&lt;br&gt;→ navega a /api/public/consents/{token}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="250" width="380" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s2b" value="GET /api/public/consents/{token}&lt;br&gt;(sin autenticación)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="350" width="380" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s2c" value="GetConsentByTokenQueryHandler&lt;br&gt;→ ConsentTokenService.ValidateConsentToken(token)&lt;br&gt;→ extrae appointmentId del JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="440" width="380" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s2d" value="¿Token válido y no expirado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="550" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s2e" value="401 Unauthorized&lt;br&gt;Token inválido o expirado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1030" y="560" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s2f" value="¿Consent existe en BD?&lt;br&gt;ConsentRepository.GetByAppointmentIdAsync()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="660" width="380" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s2g" value="new Consent(appointmentId, clientId)&lt;br&gt;IsSigned = false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1110" y="660" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s2h" value="200 OK — ConsentDto&lt;br&gt;{ id, appointmentId, clientId,&lt;br&gt;isSigned: false, signedAt: null }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="760" width="380" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s2i" value="Cliente ve el formulario&lt;br&gt;de consentimiento en su móvil" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="870" width="380" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="es2a" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s2a" target="s2b" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es2b" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s2b" target="s2c" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es2c" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s2c" target="s2d" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es2d" value="NO" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s2d" target="s2e" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es2e" value="SÍ" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s2d" target="s2f" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es2f" value="NO → crear" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s2f" target="s2g" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es2g" value="SÍ → usar existente" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s2f" target="s2h" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es2h" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s2g" target="s2h" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es2i" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s2h" target="s2i" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== PASO 3: Firma ===== -->
        <mxCell id="s3" value="PASO 3 — Cliente firma el consentimiento" style="text;html=1;fontStyle=1;fontSize=13;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="700" y="970" width="480" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="s3a" value="POST /api/public/consents/{token}/sign&lt;br&gt;{ signatureBase64: &quot;data:image/png;base64,...&quot; }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="1010" width="380" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s3b" value="FluentValidation&lt;br&gt;SignConsentCommandValidator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="1110" width="380" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s3c" value="ValidateConsentToken(token)&lt;br&gt;→ extrae appointmentId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="1200" width="380" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s3d" value="¿Ya firmado?&lt;br&gt;(IsSigned == true)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="1290" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s3e" value="403 Forbidden&lt;br&gt;REG-04-02: inmutable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1300" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s3f" value="consent.Sign(signatureBase64)&lt;br&gt;IsSigned = true&lt;br&gt;SignedAt = DateTimeOffset.UtcNow&lt;br&gt;SignatureBase64 = &quot;...&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="1400" width="380" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s3g" value="SaveChangesAsync()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="1520" width="380" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s3h" value="200 OK — ConsentDto&lt;br&gt;{ isSigned: true, signedAt: &quot;2024-...&quot; }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="1600" width="380" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="es3a" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s3a" target="s3b" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es3b" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s3b" target="s3c" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es3c" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s3c" target="s3d" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es3d" value="SÍ" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s3d" target="s3e" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es3e" value="NO" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s3d" target="s3f" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es3f" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s3f" target="s3g" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es3g" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s3g" target="s3h" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== Transition arrow staff -> client ===== -->
        <mxCell id="transition" value="Cliente escanea el QR" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#82b366;fontSize=11;" edge="1" source="s1e" target="s2a" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
